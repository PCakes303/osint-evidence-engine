{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mrcakes931.dev/osint/evidence-manifest/1.0.0",
  "title": "OSINT Evidence Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "evidence_id",
    "source_id",
    "collection_request_id",
    "source_url",
    "acquired_at",
    "captured_by",
    "identity_authorization_ref",
    "policy_decision_ref",
    "emergency_state_ref",
    "compliance_review_ref",
    "audit_event_ref",
    "source_license",
    "data_classification",
    "content_sha256",
    "content_size",
    "content_type",
    "retention_days",
    "legal_hold",
    "state"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100
    },
    "collection_request_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "acquired_at": {
      "type": "string",
      "format": "date-time"
    },
    "captured_by": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "identity_authorization_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "policy_decision_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "emergency_state_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "compliance_review_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "audit_event_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "source_license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "data_classification": {
      "const": "public"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "content_size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10485760
    },
    "content_type": {
      "enum": [
        "application/json",
        "text/plain",
        "text/csv",
        "application/pdf",
        "text/html",
        "application/xml"
      ]
    },
    "retention_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365
    },
    "legal_hold": {
      "const": false
    },
    "state": {
      "enum": [
        "captured",
        "verified",
        "reviewed"
      ]
    }
  }
}
